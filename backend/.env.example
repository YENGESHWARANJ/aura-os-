# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aura_os?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Frontend & Mobile CORS Origins
FRONTEND_URL=http://localhost:5173
MOBILE_URL=http://localhost:8081

# AI & External API Keys (Optional / Service integrations)
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key_here
